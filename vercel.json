{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/og.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/role-page.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/:ikon(icon-192.png|icon-512.png|apple-touch-icon.png|favicon.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/kurulumcu",
      "destination": "/kurulumcu/index.html"
    },
    {
      "source": "/danisman",
      "destination": "/danisman/index.html"
    },
    {
      "source": "/tedarikci",
      "destination": "/tedarikci/index.html"
    },
    {
      "source": "/fatura-analizi",
      "destination": "/"
    },
    {
      "source": "/hesaplayici",
      "destination": "/"
    },
    {
      "source": "/akademi",
      "destination": "/"
    },
    {
      "source": "/kurulum-sureci",
      "destination": "/"
    },
    {
      "source": "/danismanlar",
      "destination": "/"
    },
    {
      "source": "/hakkimda",
      "destination": "/"
    },
    {
      "source": "/kvkk",
      "destination": "/"
    },
    {
      "source": "/gizlilik",
      "destination": "/"
    },
    {
      "source": "/cerez",
      "destination": "/"
    },
    {
      "source": "/kullanim-sartlari",
      "destination": "/"
    },
    {
      "source": "/abonelik-sozlesmesi",
      "destination": "/"
    },
    {
      "source": "/acik-riza",
      "destination": "/"
    }
  ]
}
